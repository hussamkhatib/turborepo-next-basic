{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build-docs": "turbo build --filter=docs",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "env-check:common": "dotenv-checker --schema .env.example --env .env",
    "predev": "dotenv-checker --schema .env.schema --env .env.local",
    "hussam-vercel": "ts-node ./node_modules/.pnpm/@gitpkg.vercel.app+hussamkhatib+vercel+packages@cli+main/node_modules/hussam-vercel/src/index.ts"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "dotenv-checker": "^1.1.5",
    "dotenv-cli": "^7.0.0",
    "prettier": "^3.1.1",
    "turbo": "^2.0.14"
  },
  "dependencies": {
    "randomcolor": "github:davidmerfield/randomColor",
    "vercel-monorepo": "github:hussamkhatib/vercel#git-meta-data"
  },
  "packageManager": "pnpm@8.9.0",
  "engines": {
    "node": ">=18"
  }
}
